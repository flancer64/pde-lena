{
  "name": "@pde-host/pde-template",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Digital Embassy for Template Owner.",
  "type": "module",
  "files": [
    ".env.example",
    "bootstrap",
    "etc",
    "README.md",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "Pde_Template_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      },
      "cli": {
        "command": {
          "default": "web:start"
        },
        "plugin": "Pde_Template_Cli_Plugin$",
        "container": {
          "configurator": "./bootstrap/di-config.mjs"
        }
      }
    }
  },
  "scripts": {
    "db:migrate": "teq db:migrate",
    "start": "teq web:start",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@flancer32/pde-desk-echo": "github:flancer32/pde-desk-echo#main",
    "@flancer32/pde-desk-telegram": "github:flancer32/pde-desk-telegram#main",
    "@flancer32/pde-runtime": "github:flancer32/pde-runtime#main",
    "@flancer32/pde-sdk": "github:flancer32/pde-sdk#main",
    "@teqfw/cli": "^2.2.0",
    "pg": "^8.23.0",
    "@teqfw/di": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.0"
  }
}
